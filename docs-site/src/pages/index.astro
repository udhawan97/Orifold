---
import '../styles/tokens.css';
import '../styles/landing-workspace.css';
import site from '../data/site.json';
import media from '../data/media.json';
import { getRelease } from '../lib/release';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rel = await getRelease();
const version = rel.version ? 'v' + rel.version : 'Latest release';
const downloadLabel = rel.downloadKind === 'release' ? 'View the Mac release' : 'Download for Mac';
const format = rel.downloadKind === 'release' ? 'Release page' : rel.downloadKind.toUpperCase();
const title = 'Orifold — Many files. One clear PDF.';
const description = 'A free, local-first PDF workspace for Mac. Arrange pages, mark up drafts, search scans, and prepare a document to share.';
const canonical = new URL(base + '/', Astro.site).toString();
const schema = {
	'@context': 'https://schema.org', '@type': 'SoftwareApplication',
	name: 'Orifold', applicationCategory: 'BusinessApplication',
	operatingSystem: 'macOS ' + site.minMacOS + '+', description,
	url: canonical, downloadUrl: rel.downloadUrl,
	...(rel.version ? { softwareVersion: rel.version } : {}),
	license: 'https://www.apache.org/licenses/LICENSE-2.0',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
const jobs = [
	{ title: 'Put the pages in order', text: 'Bring PDFs, images, and supported office or text files into one workspace. Reorder, rotate, crop, and review the outline.', href: 'import/combine/', label: 'Combine and organize' },
	{ title: 'Review the actual document', text: 'Highlight, add notes, place a visual signature, or compare drafts. Text replacement is visual editing; use the separate Redact tool for supported permanent removal.', href: 'annotate/markup/', label: 'Mark up a draft' },
	{ title: 'Make scans searchable', text: 'On-device Vision OCR adds a searchable text layer. Inspect the result and any partial-success report before sharing.', href: 'edit/ocr/', label: 'Search a scan' },
	{ title: 'Prepare a copy to share', text: 'Compress a PDF, choose a layout, remove metadata and attachments with Sanitize, or protect the PDF with an AES-256 password.', href: 'export/export-save/', label: 'Choose an export' },
];
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#eef0f2" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href={base + '/favicon.svg'} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Orifold" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL(base + '/assets/orifold-social-preview.png', Astro.site).toString()} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Orifold’s app icon, Many files. One clear PDF, and an actual source-build sample workspace." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(base + '/assets/orifold-social-preview.png', Astro.site).toString()} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
		<script is:inline>
			try {
				if (localStorage.getItem('starlight-theme') === 'dark') document.documentElement.dataset.theme = 'dark';
			} catch {}
		</script>
	</head>
	<body class="workspace-home">
		<a class="skip-link" href="#main-content">Skip to content</a>
		<header class="site-header">
			<nav class="page-width navigation" aria-label="Primary">
				<a class="brand" href={base + '/'}>
					<img src={base + '/assets/orifold-app-icon-32.png'} width="32" height="32" alt="" />
					<span>Orifold</span>
				</a>
				<div class="nav-links">
					<a class="wide-link" href="#features">What it does</a>
					<a class="wide-link" href="#keep">Privacy</a>
					<a href={base + '/get-started/workflows/'}>Guide</a>
					<button type="button" class="theme-toggle" data-theme-toggle hidden aria-label="Switch to dark theme" aria-pressed="false"><span>Dark theme</span></button>
				</div>
			</nav>
		</header>

		<main id="main-content" tabindex="-1">
			<section id="sheet" class="page-width hero">
				<div class="hero-copy">
					<p class="eyebrow">A native PDF workspace for Mac</p>
					<h1>Many files.<br /><span>One clear PDF.</span></h1>
					<p class="hero-intro">Arrange the pages. Mark up the draft. Search the scan. Bring your paperwork together in one local workspace.</p>
					<div class="action-row">
						<a class="button primary" id="cta-hero" href={rel.downloadUrl}><img class="platform-icon" src={base + '/assets/platform-macos.svg'} width="20" height="20" alt="" />{downloadLabel}</a>
						<a class="text-link" href={base + '/get-started/first-workspace/'}>Take the first steps <span aria-hidden="true">↗</span></a>
					</div>
					<p class="download-meta">{version} · macOS {site.minMacOS}+ · Apple Silicon + Intel{rel.dmgSize ? ' · ' + rel.dmgSize : ''}</p>
					<p class="beta-note"><strong>Open-source beta.</strong> Keep your originals and check an exported copy before replacing important paperwork. <a href="#horizon">Read the current limits.</a></p>
				</div>
				<figure class="workspace-proof">
					<a href={base + media.workspace.src} aria-label="Open the Orifold workspace screenshot at full size">
						<img src={base + media.workspace.src} width={media.workspace.width} height={media.workspace.height} alt={media.workspace.alt} fetchpriority="high" />
					</a>
					<figcaption><span class="proof-label">The workspace</span>{media.workspace.caption}</figcaption>
				</figure>
			</section>

			<section id="gather" class="workflow-band">
				<div class="page-width workflow">
					<div><p class="eyebrow">From loose files to a shared copy</p><h2>One workspace.<br />A deliberate last step.</h2></div>
					<ol>
						<li><strong>Bring the files.</strong><span>Import up to 50 files per batch. Add another batch when the first finishes.</span></li>
						<li><strong>Make it readable.</strong><span>Order pages, add markup, or run OCR. Use Undo while you review.</span></li>
						<li><strong>Export and inspect.</strong><span>Choose the output, save a copy, then reopen it to check the pages and content.</span></li>
					</ol>
				</div>
			</section>

			<section id="features" class="page-width section">
				<div class="section-heading" id="shape"><p class="eyebrow">Useful, everyday PDF work</p><h2>A home for the whole task.</h2><p>Work with the document in front of you. The guide explains each tool’s scope and limitations.</p></div>
				<div class="job-list">
					{jobs.map((job) => <article><h3>{job.title}</h3><p>{job.text}</p><a class="text-link" href={base + '/' + job.href}>{job.label} <span aria-hidden="true">↗</span></a></article>)}
				</div>
				<div class="reading-row" id="seal">
					<div><h3>Room to read, too.</h3><p>Follow the Contents, listen with Read Aloud, or use Reader Mode and Document Comfort. On macOS 15+, Apple’s on-device translation can help with a selection or page.</p><a class="text-link" href={base + '/reading/reader-mode/'}>Read comfortably <span aria-hidden="true">↗</span></a></div>
					<div class="language-note"><strong>Six app languages</strong><p>English · Español · Français<br />हिन्दी · 日本語 · 简体中文</p><a href={base + '/settings/language/'}>Change the app language</a><small>The documentation is currently in English.</small></div>
				</div>
			</section>

			<section id="keep" class="trust-section">
				<div class="page-width trust-grid">
					<div><p class="eyebrow">Your files, on your Mac</p><h2>Local work.<br />Clear boundaries.</h2><p>Import, page editing, OCR, compression, and PDF export run locally. You don’t need an Orifold account or a processing server.</p><a class="text-link" href={base + '/settings/privacy/'}>Read the privacy details <span aria-hidden="true">↗</span></a></div>
					<dl>
						<div><dt>Document content stays local</dt><dd>Orifold does not upload your PDFs or their text for document processing.</dd></div>
						<div><dt>Network actions are explicit</dt><dd>Updates use GitHub release metadata and downloads. An optional signing timestamp request sends a signature hash; macOS may download a language model before on-device translation.</dd></div>
						<div><dt>Free and inspectable</dt><dd>Apache 2.0 source, no subscription, and no analytics pipeline. The app is still beta; inspect the output you plan to share.</dd></div>
					</dl>
				</div>
			</section>

			<section id="horizon" class="page-width section limits-section">
				<div class="section-heading"><p class="eyebrow">Before important paperwork</p><h2>Know the edges.</h2><p>More controls are useful only when you know what they preserve.</p></div>
				<div class="limits-grid">
					<article><h3>Forms need care</h3><p>Form-bearing pages cannot move between source documents. Form-answer saving remains under investigation; verify answers after reopening a saved copy.</p><a href={base + '/fill-sign/forms/#current-limits'}>Current form limits</a></article>
					<article><h3>Keep source attachments</h3><p>Moving the last page removes its source from the workspace. Transfer of that source’s embedded files has not been verified. Keep the original and inspect attachments.</p><a href={base + '/import/organize-pages/#preserve-source-documents'}>Page-move boundaries</a></article>
					<article><h3>Visual edits aren’t redaction</h3><p>Original text may remain discoverable after visual replacement. The separate beta Redact tool refuses unsupported cases; check its result before sharing.</p><a href={base + '/edit/redact/'}>Read the redaction guide</a></article>
				</div>
			</section>

			<section id="final-fold" class="download-section">
				<div class="page-width download-grid">
					<div>
						<p class="eyebrow">Take the workspace with you</p><h2>Made for your Mac.</h2>
						<p>macOS {site.minMacOS} Sonoma or newer. One universal app for Apple Silicon and Intel.</p>
						<a class="button primary" id="cta-final" href={rel.downloadUrl}><img class="platform-icon" src={base + '/assets/platform-macos.svg'} width="20" height="20" alt="" />{downloadLabel}</a>
						<p class="download-meta">{version} · {format}{rel.dmgSize ? ' · ' + rel.dmgSize : ''}</p>
						<p class="release-links"><a href={rel.releaseUrl}>Release notes &amp; checksums</a>{rel.zipAvailable && <a href={rel.zipUrl}>ZIP alternative</a>}<a href={base + '/get-started/install/'}>Install guide</a></p>
						{!rel.metadataAvailable && <p class="small-note">See the GitHub release page for the current version and checksum. These download links also work without JavaScript.</p>}
						<aside class="first-launch"><strong>First launch</strong><p>Public builds are ad-hoc signed and are not Apple-notarized unless the release states otherwise. macOS may ask you to approve opening the app in Privacy &amp; Security. Read the install guide before proceeding.</p></aside>
					</div>
					<div class="install-options">
						<details><summary>Install from Terminal</summary><p>The bootstrap downloads the prebuilt app to <code>~/Applications/Orifold.app</code>. No Xcode is needed.</p><pre><code id="install-command">curl -fsSL https://raw.githubusercontent.com/udhawan97/Orifold/main/install.sh | zsh</code></pre><button type="button" class="copy-command" hidden>Copy install command</button><p class="copy-status" role="status"></p><p>The script clears the downloaded app’s quarantine. Use the manual DMG route in the install guide if you prefer macOS’s normal first-launch approval flow.</p><a href={base + '/get-started/install/'}>All install options, including Homebrew</a></details>
						<details><summary>Build from source</summary><p>Use macOS and Apple Command Line Tools with Swift 6.1+.</p><pre><code>git clone https://github.com/udhawan97/Orifold.git
cd Orifold
swift build</code></pre><a href={base + '/developers/build/'}>Build and test instructions</a></details>
						<details id="updates"><summary>Update and uninstall</summary><p>Use <strong>Check for Updates…</strong> in the Orifold menu, or install the next release deliberately. Cancelling quit stops the uninstaller before removal.</p><a href={base + '/get-started/update-uninstall/'}>Update, restore, and removal details</a></details>
					</div>
				</div>
			</section>

			<section id="ma" class="page-width companion-row">
				<div class="companion-art"><img src={base + '/assets/gami-figure.svg'} width="88" height="88" alt="Gami, the origami dog" loading="lazy" /><img src={base + '/assets/ori-figure.svg'} width="88" height="88" alt="Ori, the origami cat" loading="lazy" /></div>
				<div><h2>A little company. Optional.</h2><p>Gami and Ori keep a quiet corner of the workspace. Choose a companion or turn the buddy off from the app menu.</p><a href={base + '/get-started/companion/'}>Meet the paper companions</a></div>
			</section>
		</main>
		<footer class="site-footer" id="fortune-fold"><div class="page-width footer-row"><a class="brand" href={base + '/'}><img src={base + '/assets/orifold-app-icon-32.png'} width="28" height="28" alt="" />Orifold</a><p>One sheet, folded into flight.</p><div><a href={site.repoUrl}>Source</a><a href={base + '/releases/'}>What’s new</a><a href={site.repoUrl + '/issues'}>Get help</a></div></div></footer>
		<script>
			const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
			function syncTheme() {
				const dark = document.documentElement.dataset.theme === 'dark';
				if (!themeButton) return;
				themeButton.hidden = false;
				themeButton.setAttribute('aria-pressed', String(dark));
				themeButton.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
				themeButton.textContent = dark ? 'Light theme' : 'Dark theme';
			}
			syncTheme();
			themeButton?.addEventListener('click', () => {
				const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				document.documentElement.dataset.theme = theme;
				try { localStorage.setItem('starlight-theme', theme); } catch {}
				syncTheme();
			});
			const copy = document.querySelector<HTMLButtonElement>('.copy-command');
			if (copy) {
				copy.hidden = false;
				copy.addEventListener('click', async () => {
					const command = document.querySelector('#install-command')?.textContent ?? '';
					const status = document.querySelector<HTMLElement>('.copy-status');
					try {
						await navigator.clipboard.writeText(command);
						if (status) status.textContent = 'Install command copied.';
					} catch {
						if (status) status.textContent = 'Copy unavailable. Select the command above.';
					}
				});
			}
		</script>
	</body>
</html>
