---
interface Props {
	src?: string;
	alt: string;
	caption?: string;
}
const { src, alt, caption } = Astro.props;
const isPlaceholder = !src;
const historical = Boolean(src && /\/(?:first-workspace-empty-state|the-orifold-window-annotated|annotate-markup-tools|night-mode-comparison|reader-mode-toggle|language-switcher|edit-text-workflow|export-save-confirmation|combine-reorder-pages|reorder-rotate-delete-pages|import-files-overview|recently-viewed-shelf)\.png$/.test(src));
---

<figure class="of-figure">
	{
		isPlaceholder ? (
			<div class="of-figure-placeholder" role="img" aria-label={alt}>
				{alt}
			</div>
		) : (
			<img src={src} alt={alt} loading="lazy" />
		)
	}
	{(caption || historical) && <figcaption>{caption}{historical && <small class="capture-provenance">Historical capture (v0.8.1 source build); current controls may differ.</small>}</figcaption>}
</figure>

<style>.capture-provenance { display: block; margin-top: .5em; }</style>
